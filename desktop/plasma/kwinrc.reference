[Desktops]
Id_1=placeholder-desktop-1
Id_2=placeholder-desktop-2
Id_3=placeholder-desktop-3
Name_1=Desktop 1
Number=3
Rows=1

[Effect-windowview]
BorderActivateAll=1

[ElectricBorders]
BottomRight=ShowDesktop

[Plugins]
desktopchangeosdEnabled=true
dynamic_workspacesEnabled=true

[TabBox]
DesktopMode=0
LayoutName=compact

[Xwayland]
Scale=1
XwaylandEisNoPromptApps=steam

[org.kde.kdecoration2]
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__ChromeOS-dark
