# =============================================================================
# rclone-drive001.service
# =============================================================================
# Monta o Google Drive (remote: drive001) via rclone no boot do usuário.
# Remote precisa estar configurado:  rclone config  (criar remote "drive001")
# =============================================================================
[Unit]
Description=Mount Google Drive (drive001)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

ExecStart=/usr/bin/rclone mount drive001: %h/Gdrive/drive001 \
    --vfs-cache-mode full \
    --dir-cache-time 72h \
    --poll-interval 1m

ExecStop=/bin/fusermount -u %h/Gdrive/drive001

Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
