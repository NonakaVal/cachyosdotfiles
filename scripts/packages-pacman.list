base-devel
linux-cachyos                 # kernel principal (7.1.x)
linux-cachyos-headers
linux-cachyos-lts             # kernel LTS (fallback)
linux-cachyos-lts-headers
linux-cachyos-nvidia-open     # módulos NVIDIA open para kernel atual
linux-cachyos-lts-nvidia-open # módulos NVIDIA open para kernel LTS
linux-firmware
intel-ucode                   # microcode Intel
dkms

